{
  "name": "dsh-drift-gate",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Minimal drift gate for DeepSeek Harness: before each turn closes, a read-only subagent checks whether the final visible answer clearly drifted from the user's request; drift is injected back and steered.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gate",
    "drift",
    "verification"
  ],
  "license": "MIT"
}
